# API base path used by frontend/src/api/client.ts.
# All versioned DRF endpoints live under /api/v1/ (config/urls.py); the
# dashboard endpoints (/api/dashboards/*) are reached via the interceptor in
# api/client.ts, which lets absolute '/dashboards/...' paths escape this prefix.
VITE_API_BASE_URL=/api/v1

# Proxied by Vite to http://localhost:8000 (see vite.config.ts) - no CORS in dev.
VITE_PROXY_TARGET=http://localhost:8000

# Toggle the mock auth/data layer. Set to false when the Django API is live.
VITE_USE_MOCKS=true

# One of: super_admin | dept_admin | professor | head_ta | ta
# (the backend has no STUDENT role — see frontend/src/constants/roles.ts)
VITE_MOCK_ROLE=super_admin

# Opt-in for the dev-only /preview UI-kit routes. Even when true they remain
# behind ProtectedRoute, and the whole subtree is stripped from prod builds.
VITE_ENABLE_PREVIEW=false

# Backend-side flag (root .env, NOT read by Vite): set DEBUG=true for local
# development. It enables Django debug mode and the Swagger/Spectacular docs;
# it MUST be false/absent in production or the API docs get publicly exposed.
DEBUG=false
